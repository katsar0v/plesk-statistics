{
    "name": "katsar0v/plesk-statistics",
    "type": "project",
    "description": "Live Traffic Monitor: a Plesk Obsidian extension that shows HTTP requests across all hosted websites in near real time. Administrators only.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/katsar0v/plesk-statistics",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "plesk/pm-api-stubs": "18.0.76"
    },
    "autoload-dev": {
        "classmap": ["src/plib/library/"],
        "psr-4": {
            "LiveTrafficMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
